{
  "manifest_version": 3,
  "name": "Phisheck",
  "version": "0.1.0",
  "description": "Detects phishing pages on your machine. Nothing you browse ever leaves your computer.",
  "minimum_chrome_version": "120",
  "permissions": ["webNavigation", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "spanning",
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Phisheck",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "settings.html"
}
